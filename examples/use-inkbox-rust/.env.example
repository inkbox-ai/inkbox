# Required — get one at https://inkbox.ai/console
INKBOX_API_KEY=

# Optional — override the API host
# INKBOX_BASE_URL=https://inkbox.ai

# Optional — handle for the identity the example creates
# INKBOX_AGENT_HANDLE=rust-demo

# Optional — where the test email is sent (defaults to the agent's own address)
# INKBOX_DEMO_EMAIL=

# Optional — destination for the call; unset skips provisioning and calling
# INKBOX_DEMO_PHONE=+15551234567

# Optional — US state abbreviation for the provisioned number
# INKBOX_DEMO_STATE=NY

# Optional — wss:// URL to stream call audio to
# INKBOX_DEMO_WEBSOCKET=

# Optional — set to anything to skip teardown and keep the identity
# INKBOX_KEEP_IDENTITY=

# --- 02-vault-totp ---
# Required for the vault example; initialize the vault from the console first
# INKBOX_VAULT_KEY=

# --- 07-signup ---
# Required for `register` — human who owns or approves the agent
# INKBOX_HUMAN_EMAIL=
# Optional — message included in the verification email
# INKBOX_NOTE_TO_HUMAN=
# Optional — A2A connection invitation link or raw token
# INKBOX_A2A_INVITATION=
# Set from the `register` output, needed by send-welcome and cleanup
# INKBOX_AGENT_HANDLE_SAVED=
# Optional — alternative to `verify --code`
# INKBOX_VERIFICATION_CODE=
