# .gitignore

*PLAN.md

*.npmrc

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.venv/
*.egg
.eggs/

# TypeScript / JavaScript
node_modules/
coverage/
*.tsbuildinfo
*.js.map
*.ts.map

# Keep release-validated adapter examples reproducible.
# Other example apps and integration-test scaffolding omit lockfiles.
examples/**/package-lock.json
!examples/chat-sdk/package-lock.json
!examples/eve-agent/package-lock.json
examples/**/uv.lock
tests/integration/**/package-lock.json

# Python testing asnd linting
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environment
.env
.env.*
!.env.example

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
