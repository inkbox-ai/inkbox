  "title": "Event",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inkbox.ai/schemas/hosted-chat-event-v1.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.created"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/MessageData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.delta"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/DeltaData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/MessageData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "turn.updated"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/TurnData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.started"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/ToolData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.updated"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/ToolData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool.completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/ToolData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "interaction.created"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/InteractionData"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "interaction.updated"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/InteractionData"
          }
        }
      }
    },
    {
