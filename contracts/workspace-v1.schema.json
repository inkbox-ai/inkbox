        "idle_stop_enabled": {
          "title": "Idle Stop Enabled",
          "type": "boolean"
        },
        "idle_timeout_seconds": {
          "title": "Idle Timeout Seconds",
          "type": "integer"
        },
        "schedules_may_start": {
          "title": "Schedules May Start",
          "type": "boolean"
        },
        "selected_events_may_start": {
          "default": false,
          "title": "Selected Events May Start",
          "type": "boolean"
        }
