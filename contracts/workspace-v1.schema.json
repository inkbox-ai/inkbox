      "additionalProperties": false,
      "properties": {
        "applied_generation": {
          "title": "Applied Generation",
          "type": "integer"
        },
        "generation": {
          "title": "Generation",
          "type": "integer"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Observed At"
        },
        "stale": {
          "title": "Stale",
          "type": "boolean"
        },
        "state": {
          "enum": [
            "ready",
            "initializing",
            "degraded",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "observed_at",
        "stale",
        "generation",
        "applied_generation"
      ],
      "title": "Agent",
      "type": "object"
    },
    "Automation": {
      "additionalProperties": false,
